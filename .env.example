# Apple MusicKit API credentials
# Get these from developer.apple.com → Keys → + → enable MusicKit
APPLE_TEAM_ID=
APPLE_KEY_ID=
# Paste the full content of your .p8 file (including -----BEGIN PRIVATE KEY----- and -----END PRIVATE KEY-----)
APPLE_PRIVATE_KEY=

# Navidrome credentials for auto-playlist creation
NAVIDROME_URL=https://your-navidrome-instance.example.com
NAVIDROME_USER=
NAVIDROME_PASSWORD=
